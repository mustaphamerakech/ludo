rules_version = '2';
// Ludo Mini - Firestore security rules.
// Paste this whole text in Firebase console > Firestore Database > Rules, then Publish.
service cloud.firestore {
  match /databases/{database}/documents {
    function isMe(uid) { return request.auth != null && request.auth.uid == uid; }
    function okProfile(d) {
      return d.name is string && d.name.size() > 0 && d.name.size() <= 16
        && d.xp is int && d.xp >= 0
        && d.coins is int && d.coins >= 0
        && d.code is string && d.code.size() == 6;
    }

    match /users/{uid} {
      // Any signed-in player can see profiles (names, levels, ranking, who is online).
      allow read: if request.auth != null;
      // Only you can create or change your own profile, with limits so nobody gives themselves
      // a huge level or coins in one go.
      allow create: if isMe(uid) && okProfile(request.resource.data)
        && request.resource.data.xp <= 5000 && request.resource.data.coins <= 5000;
      allow update: if isMe(uid) && okProfile(request.resource.data)
        && request.resource.data.code == resource.data.code
        && request.resource.data.xp >= resource.data.xp
        && request.resource.data.xp - resource.data.xp <= 300
        && request.resource.data.coins - resource.data.coins <= 200;

      // Friends list: you manage yours; a friend can add themselves when you add each other.
      match /friends/{fid} {
        allow read, delete: if isMe(uid);
        allow create, update: if isMe(uid) || isMe(fid);
      }

      // Game invitations: only your friends can invite you; only you read and remove them.
      match /invites/{fid} {
        allow read, delete: if isMe(uid);
        allow create, update: if isMe(fid)
          && exists(/databases/$(database)/documents/users/$(uid)/friends/$(fid));
      }
    }
  }
}
